# LEHAR Early-Warning Console — copy to .env.local for local development.
#
# Base URL of the LEHAR FastAPI backend (no trailing slash, no /api/v1).
# NEXT_PUBLIC_* values are inlined into the browser bundle AT BUILD TIME:
# change it, then rebuild (on Vercel: set it in Project Settings -> Environment
# Variables before deploying). The backend must list this console's origin in
# FRONTEND_ORIGINS (backend/.env) or the browser will block every request.
NEXT_PUBLIC_API_URL=http://localhost:8000
