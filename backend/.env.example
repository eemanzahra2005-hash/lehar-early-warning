# Copy this file to backend/.env and adjust values for your local machine.
# Never commit the real .env file — it is gitignored.
#
# Phase 15.2: this ONE file configures the app in BOTH modes — the host-run
# (no-Docker) server reads it directly, and docker-compose.yml's "api"
# container loads it via env_file (e.g. LLM_CLOUD_API_KEY below works either
# way). Inside the container, five container-specific values set by
# docker-compose.yml win instead of what's here: DATABASE_URL, JWT_SECRET
# (from the root .env), OLLAMA_BASE_URL, MLFLOW_TRACKING_URI, PORT.

# Human-readable application name, shown in /api/v1/health
APP_NAME="LEHAR — Level-based Early-warning for Hydrological & Agricultural Risk"

# API version prefix for all routes
API_V1_PREFIX="/api/v1"

# Current environment: local | development | staging | production
ENVIRONMENT="local"

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500"

# --- Split-deployment CORS (LEHAR Phase 1) ---
# Comma-separated origins of the SEPARATE frontend(s) that call this API
# cross-origin — the Next.js Early-Warning Console (LEHAR Phase 5), on
# localhost:3000 in dev and on a Vercel domain once deployed. MERGED with
# CORS_ORIGINS above (de-duplicated, order preserved) rather than replacing
# it, so this repo's own same-origin vanilla frontend keeps working
# unchanged. Auth is bearer-token based (Authorization: Bearer <jwt>), not
# cookie based — see docs/API_AUTH.md for what the console has to send.
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# --- Memory diagnostics (LEHAR Phase 1) ---
# true = log this process's resident set size (RSS, in MB) once at startup,
# so a 512MB-constrained host's deploy log records what the process actually
# costs at boot. Off by default: it is a diagnostic, not normal operation.
# GET /api/v1/health/deep reports CURRENT RSS regardless of this flag. Both
# report a real psutil reading or null — never an estimate (CLAUDE.md rule
# 4). See docs/MEMORY.md for the measured numbers.
LOG_MEMORY=false

# Path to the synthetic training dataset CSV, used by backend/ml/train_model.py.
# Relative paths are resolved against the project root. Not read by the FastAPI
# app itself — only by the standalone training script.
DATA_PATH="data/synthetic_irrigation_dataset_pk107.csv"

# Secret key used to sign JWT access AND refresh tokens. MUST be overridden
# with a long random value in every real .env — never use the placeholder
# default in anything other than throwaway local testing. Generate a strong
# one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET="dev-only-change-me-in-your-.env"

# How long an issued JWT ACCESS token stays valid, in minutes (default: 60 —
# Phase 11 shortened this from 7 days; a leaked access token now only works
# for an hour). Long-lived sessions are carried by the refresh token below.
JWT_EXPIRE_MINUTES=60

# How long an issued JWT REFRESH token stays valid, in minutes (default: 7
# days). Exchanged for a new access token via POST /api/v1/auth/refresh —
# frontend/js/api.js does this silently, once, on any 401.
JWT_REFRESH_EXPIRE_MINUTES=10080

# Path to the SQLite database file. Relative paths are resolved against the
# project root. The parent folder is created automatically if it's missing.
# Only used as a fallback to build the default sqlite:// URL below when
# DATABASE_URL is empty.
DB_PATH="backend/data/app.db"

# --- Database engine (Phase 9) ---
# Full SQLAlchemy connection URL. Leave EMPTY (default) to use the SQLite
# file at DB_PATH above - the zero-setup dev/test default, unchanged since
# Phase 3. Set this to opt into PostgreSQL instead (see docs/DATABASE.md):
#   1. docker compose up -d db   (postgres:16-alpine, see root .env.example
#      for POSTGRES_USER/PASSWORD/DB - a SEPARATE file from this one, only
#      read by docker compose)
#   2. scripts\db_upgrade.bat    (applies Alembic migrations - the sole
#      source of truth for schema once this is set; create_all() is a
#      SQLite-only fallback and is skipped entirely against Postgres)
# Uses psycopg v3 (postgresql+psycopg://), NOT psycopg2
# (postgresql+psycopg2:// / postgresql://) - psycopg2-binary has no
# prebuilt wheel for Python 3.14 on Windows yet, see docs/DATABASE.md.
# DATABASE_URL="postgresql+psycopg://irrigation:your-password@localhost:5432/smart_irrigation"
DATABASE_URL=

# Which model version to load from backend/ml/model/registry.json.
# "latest" (the default) follows the registry's "latest" pointer — the full,
# most accurate model, which is what local dev should serve.
#
# Pin an exact version string instead to freeze what gets served. This is
# how the 512MB deployment selects the COMPACT DEPLOYMENT MODEL: it is a
# normal registered version that deliberately never became "latest" (see
# backend/ml/pipeline.py --compact), so ONLY an explicit MODEL_VERSION
# selects it, e.g.
#   MODEL_VERSION="v20260923T212705208535Z"
# render.yaml sets exactly that for the deployed service. Run
# `.venv\Scripts\python scripts\check_deployment_models.py` to list every
# registered version with its real metrics, size and quality-gate verdict.
MODEL_VERSION="latest"

# HTTP timeout (seconds) for calls to the Open-Meteo weather API. Also used
# for live soil moisture (Phase 16, same API — see docs/SOIL_MOISTURE.md).
WEATHER_TIMEOUT_SECONDS=8.0

# How long (seconds) a fetched weather result is cached in memory before
# the next request re-fetches it from Open-Meteo. Also applies, per
# district, to live soil moisture (Phase 16).
WEATHER_CACHE_TTL_SECONDS=300

# How long (seconds) the whole GET /api/v1/map/overview response (all
# districts) is cached in memory before the next request recomputes it
MAP_OVERVIEW_TTL_SECONDS=600

# How long (seconds) the whole GET /api/v1/flood/overview response (all
# districts' GloFAS river-discharge flood risk) is cached in memory before
# the next request recomputes it
FLOOD_CACHE_TTL_SECONDS=3600

# Flood Risk Index component weights (must documented in docs/FLOOD_RISK.md).
# Not required to sum to 1.0, but the reference implementation's 4 weights do.
FLOOD_W_DISCHARGE=0.30
FLOOD_W_RAIN_3DAY=0.25
FLOOD_W_RAIN_INTENSITY=0.15
FLOOD_W_EXPOSURE=0.20
FLOOD_W_MONSOON=0.10

# --- Flood lead-time model (LEHAR Phase 2.5) --------------------------------
# GET /api/v1/flood/forecast/{district} and the FLOOD_FORECAST alert type:
# a small GRU, trained on REAL GloFAS + ERA5 history, predicting river
# discharge 1-3 days ahead so an alert can fire BEFORE the flood arrives.
# See docs/FLOOD_DL.md.
#
# OFF by default, and it stays inert until a model is registered under
# backend/ml/flood_dl/model/ — a fresh checkout has none, and the endpoint
# then answers 503 with the reason rather than inventing a forecast
# (CLAUDE.md rule 4). Turning it on costs one lazy onnxruntime import and a
# ~170KB ONNX session, both deferred to the first forecast actually served,
# so a 512MB host pays nothing while this is false (CLAUDE.md rule 11).
FLOOD_DL_ENABLED=false
# "latest" follows backend/ml/flood_dl/model/registry.json's pointer, or pin
# an exact version string — same convention as MODEL_VERSION above.
FLOOD_DL_MODEL_VERSION="latest"

# Farm Risk Score (irrigation-stress/dryness) component weights — see
# docs/RISK_SCORE.md. rain_relief is SUBTRACTED from the weighted sum of the
# other four (documented in RISK_SCORE.md), so all five are still entered
# here as positive magnitudes.
RISK_W_MOISTURE_DEFICIT=0.35
RISK_W_ET0_DEMAND=0.20
RISK_W_HEAT_STRESS=0.15
RISK_W_WATER_SCARCITY=0.15
RISK_W_RAIN_RELIEF=0.15

# --- MLOps: MLflow tracking + quality gate (Phase 7) ---
# URL of the local MLflow server (docker-compose.yml's "mlflow" service —
# start with `docker compose up -d mlflow`). backend/ml/pipeline.py falls
# back to local file tracking (mlruns/) with a warning if this is
# unreachable — training always works fully offline.
MLFLOW_TRACKING_URI="http://127.0.0.1:5000"

# Quality gate thresholds (docs/MLOPS.md) — pragmatic project defaults, not
# scientific constants. QG_MAX_MAE is an absolute ceiling a candidate must
# never exceed; QG_MAE_TOLERANCE is how much worse (mm) than the CURRENT
# production model's MAE a candidate is still allowed to be; QG_MIN_R2 is an
# absolute floor. A candidate that fails never touches registry.json — the
# current production model is never auto-replaced by a worse one.
QG_MAX_MAE=1.0
QG_MAE_TOLERANCE=0.05
QG_MIN_R2=0.90

# --- AI Assistant (Phase 6.5 local-only, upgraded to hybrid in Phase 6.6) ---
# LLM provider: "hybrid" (default — cloud first when a key is set, auto
# falls back to local Ollama on any cloud error) | "ollama" (local only) |
# "cloud" (cloud only, no fallback) | "none" (disables the assistant —
# GET /assistant/status always reports available=false, chat always 503)
LLM_PROVIDER=hybrid

# Base URL of your local Ollama server (default install, no change needed)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Which Ollama model to use for local chat. Chosen automatically at setup
# time based on detected system RAM: "llama3.2:3b" (<12GB) or "qwen2.5:7b"
# (>=12GB). Must already be pulled locally: `ollama pull <model>`.
LLM_MODEL="llama3.2:3b"

# How long (seconds) to wait for a local chat reply before giving up. CPU
# inference is slow — kept generous so a real reply isn't cut off.
LLM_TIMEOUT_SECONDS=90.0

# Cloud LLM: any OpenAI-compatible chat-completions endpoint. Default points
# at Groq's free-tier API. Groq retired llama-3.3-70b-versatile on
# 2026-08-16 (https://console.groq.com/docs/deprecations) - openai/gpt-oss-120b
# is Groq's recommended replacement (a reasoning model; app/services/llm.py
# sends reasoning_effort=low and strips <think> blocks for this model family).
LLM_CLOUD_BASE_URL="https://api.groq.com/openai/v1"
LLM_CLOUD_MODEL="openai/gpt-oss-120b"
# Get a free key at console.groq.com — never commit real keys
LLM_CLOUD_API_KEY=
LLM_CLOUD_TIMEOUT_SECONDS=20.0

# --- Data-drift monitoring (Phase 8) ---
# PSI (Population Stability Index) between the production model's
# training-time reference distribution and the last DRIFT_WINDOW real
# prediction inputs from prediction_logs — see docs/DRIFT.md.
# DRIFT_PSI_WARN/ALERT are common industry heuristics, NOT scientifically
# validated for irrigation/weather data specifically.
DRIFT_WINDOW=200
# Below this many available prediction_logs rows, GET /api/v1/monitoring/drift
# reports status="insufficient_data" instead of a PSI computed on too little
# data to mean anything.
DRIFT_MIN_SAMPLES=50
DRIFT_PSI_WARN=0.1
DRIFT_PSI_ALERT=0.25

# --- Rate limiting (Phase 11) ---
# Per-client-IP requests/minute via slowapi (backend/app/rate_limit.py, an
# in-memory sliding-window store — fine for this single-process local-first
# app). Auth is tightest (brute-force/credential-stuffing resistance);
# assistant is limited separately because each call is a real LLM request
# (cloud cost or slow local CPU inference). Automatically disabled during
# the pytest suite except one dedicated test — see backend/tests/conftest.py.
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_PREDICT_PER_MINUTE=30
RATE_LIMIT_ASSISTANT_PER_MINUTE=10
# LEHAR Phase 4: email verify/unsubscribe links and the Telegram deep-link
# lookup (the subscribe call itself uses the auth limit above).
RATE_LIMIT_SUBSCRIPTION_PER_MINUTE=20

# --- Low-memory deployment mode (Phase 13, hardened in Phase 13.1) ---
# false (default): the SHAP explainer is built eagerly at startup so a
# user's first /predict call is never slowed by its one-time JIT warm-up,
# the model is loaded with a normal (non-mmap) joblib.load(), and SHAP is
# always built regardless of model size.
# true: skip the eager build (built lazily on first use instead), load the
# model with mmap_mode="r", and skip building the SHAP explainer entirely
# for any model over LOW_MEMORY_SHAP_MAX_ESTIMATORS estimators. Used on
# RAM-constrained hosts (e.g. Render's free tier — see render.yaml). Has no
# effect on correctness: explanation/confidence already degrade to null on
# any failure regardless of this flag (see docs/DEPLOY_RENDER.md).
LOW_MEMORY_MODE=false

# Only checked when LOW_MEMORY_MODE=true: the SHAP TreeExplainer is skipped
# (explanation stays null; confidence is unaffected) when the loaded
# model's n_estimators exceeds this. The memory-light deployment model
# variant (see ml/pipeline.py --sample-frac/--no-promote) is meant to stay
# comfortably under this default.
LOW_MEMORY_SHAP_MAX_ESTIMATORS=60

# --- Container/runtime variables (LEHAR Phase 1) ---
# These are read by backend/docker-entrypoint.sh and the C library, NOT by
# app/config.py, so they have no Settings field. backend/Dockerfile sets all
# three as image defaults; they are listed here so the full deployed
# configuration is documented in one place.
#
# Number of uvicorn worker processes. MUST stay 1 on a 512MB host: a second
# worker duplicates the interpreter, the sklearn/numpy/shap import cost and
# the loaded model.
WEB_CONCURRENCY=1
#
# Whether the container entrypoint runs `alembic upgrade head` before
# starting uvicorn. true on hosts with no shell access (Render free tier);
# set false where migrations are applied out-of-band.
RUN_MIGRATIONS=true
#
# glibc per-thread allocator arenas. Capping at 2 returns memory to the OS
# more readily after a /predict burst, at negligible cost with one worker.
MALLOC_ARENA_MAX=2

# --- Alert engine (LEHAR Phase 2) ---
# Five farmer-facing levels (1 White .. 5 Black, inspired by Japan's
# five-level disaster alert system) plus a grey admin-only OPS level 0.
# Every threshold below is a DOCUMENTED DEFAULT, not a scientific constant —
# docs/ALERT_LEVELS.md states each one and the reasoning behind it. The
# rules themselves are pure functions in app/services/alerts/rules.py.

# Shared secret POST /api/v1/alerts/run requires in its X-Alert-Run-Token
# header (the Phase 6 cron-job.org scheduler sends it). EMPTY = the endpoint
# is not configured and refuses every call with 503 — an unauthenticated
# alert-run endpoint would let anyone drive the whole 107-district sweep and
# write farmer-facing alerts. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
ALERT_RUN_TOKEN=

# An unchanged condition may re-notify at most this often. Escalation to a
# HIGHER level ignores the cooldown entirely — a farmer must never wait out
# a cooldown to be told things got worse.
ALERT_COOLDOWN_HOURS=12.0

# Consecutive clear runs before an active alert resolves and an ALL_CLEAR is
# emitted. 2 (not 1) so a single failed upstream fetch can't declare a
# flood over.
ALERT_CLEAR_RUNS_TO_RESOLVE=2

# Days of Open-Meteo daily forecast each run pulls per district — the window
# HEAVY_RAIN, HEAT_STRESS and IRRIGATION_DUE all read from.
ALERT_FORECAST_DAYS=3

# FLOOD: levels map from app/services/flood.py's Flood Risk Index band
# (LOW->1, WATCH->2, HIGH->3). Within HIGH, a >= 5% rise in forecast river
# discharge over the next 48 h escalates to level 4, and either an "extreme"
# Flood Risk Index score or a >= 20-year return period escalates to level 5.
# GloFAS via Open-Meteo publishes NO return period, so
# ALERT_FLOOD_RETURN_PERIOD_RATIO (forecast peak / 30-day baseline median)
# is a documented PROXY for that rarity — every alert raised this way records
# "return_period_is_proxy": true and never claims a computed return period.
ALERT_FLOOD_RISING_PCT=0.05
ALERT_FLOOD_EXTREME_SCORE=85.0
ALERT_FLOOD_RETURN_PERIOD_RATIO=3.0
ALERT_FLOOD_RETURN_PERIOD_YEARS=20

# FLOOD_FORECAST (LEHAR Phase 2.5): the same mapping, applied to the flood
# lead-time model's PREDICTED discharge 1-3 days ahead instead of today's
# observation, so an alert can fire before the water arrives. Only active
# when FLOOD_DL_ENABLED=true and a model is registered.
#
# The MAX level deliberately stops at 3, one rung below the observed FLOOD
# rule's ceiling of 5. Levels 4 and 5 take over the farmer's entire screen
# and say "evacuate now" — a ~44k-parameter research model forecasting three
# days out is not evidence enough to say that on its own, and the observed
# FLOOD rule still escalates to 4/5 the moment real discharge justifies it.
# An alert whose raw mapping was clamped records both numbers and says so in
# its text. Raise this only on the measured hit rate and false-alarm rate in
# docs/FLOOD_DL.md.
ALERT_FLOOD_FORECAST_MIN_LEVEL=2
ALERT_FLOOD_FORECAST_MAX_LEVEL=3

# HEAVY_RAIN: Open-Meteo daily precipitation_sum (mm), wettest SINGLE day —
# 80mm spread over three days is a soaking, 80mm in one day floods a field.
ALERT_HEAVY_RAIN_L2_MM=30.0
ALERT_HEAVY_RAIN_L3_MM=80.0

# HEAT_STRESS: Open-Meteo daily temperature_2m_max (Celsius). Level 2 needs
# the heat SUSTAINED across ALERT_HEAT_CONSECUTIVE_DAYS, because a single
# hot day is an ordinary Pakistani summer day; level 3 does not, because
# 45C damages a crop on its own.
ALERT_HEAT_L2_C=40.0
ALERT_HEAT_L3_C=45.0
ALERT_HEAT_CONSECUTIVE_DAYS=2

# IRRIGATION_DUE (level 1, in-app only): fires for a SAVED FIELD when the
# model recommends at least that field's own irrigation_threshold_mm and
# less than ALERT_IRRIGATION_DRY_MM of rain is forecast over the next
# ALERT_IRRIGATION_DRY_DAYS days. ALERT_IRRIGATION_THRESHOLD_MM is the
# fallback for a field with no threshold of its own (every field saved
# before this phase).
ALERT_IRRIGATION_THRESHOLD_MM=10.0
ALERT_IRRIGATION_DRY_MM=1.0
ALERT_IRRIGATION_DRY_DAYS=3

# OPS (grey, admin-only, level 0): where the cross-process platform-health
# breadcrumbs live. A quality-gate FAIL is written by the standalone
# training pipeline and a rollback by the API, which is exactly why this is
# a small JSON-lines file rather than a table. Relative paths resolve
# against the project root. The PSI trigger has no threshold of its own —
# it reuses DRIFT_PSI_ALERT above, so an OPS alert and
# GET /api/v1/monitoring/drift can never disagree about what "alert" means.
ALERT_OPS_EVENTS_PATH="backend/data/ops_events.jsonl"
ALERT_OPS_EVENT_MAX_AGE_HOURS=24.0

# --- Alert delivery channels (LEHAR Phase 3) — see docs/ALERTS.md ---
# All optional. A channel whose values are empty DISABLES ITSELF: matching
# subscribers get an honest "skipped" delivery row naming what is missing,
# the in-app channel keeps working, and nothing errors. LEHAR runs fully
# offline with every one of these left blank (CLAUDE.md rule 5).

# Telegram bot token from @BotFather (/newbot). Secret — never commit it.
TELEGRAM_BOT_TOKEN=
# The bot's @username WITHOUT the @, e.g. lehar_alerts_bot. Used to build the
# one-tap subscribe links t.me/<bot>?start=<district_code>.
TELEGRAM_BOT_USERNAME=
# Random secret Telegram echoes in the X-Telegram-Bot-Api-Secret-Token header
# on every webhook call; POST /api/v1/alerts/telegram/webhook refuses any
# request without it (503 while unset). 1-256 chars of A-Z a-z 0-9 _ -.
# Generate with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
# then register it with: .venv\Scripts\python scripts\set_telegram_webhook.py
TELEGRAM_WEBHOOK_SECRET=

# Brevo (free tier: 300 emails/day) transactional API key, from
# app.brevo.com -> SMTP & API -> API Keys. Sent over HTTPS to
# api.brevo.com/v3/smtp/email — never SMTP, which Render's free tier blocks.
BREVO_API_KEY=
# Must be a sender you have VERIFIED in Brevo (Senders, domains & IPs).
ALERT_FROM_EMAIL=
ALERT_FROM_NAME="LEHAR Alerts"

# Public https:// origin of THIS API, no trailing slash, e.g.
# https://lehar-api.onrender.com. Builds the email confirm/unsubscribe links
# and the Telegram webhook URL. Email stays disabled while this is empty,
# because every email must carry a working unsubscribe link.
PUBLIC_BASE_URL=

# Cap on Telegram + email sends (re-sends included) in ONE alert run, to stay
# inside the free tiers. Past the cap, sends are recorded as "Deferred" and
# go out on the next run, highest alert level first.
ALERT_MAX_SENDS_PER_RUN=200

# --- Alert operations (LEHAR Phase 4) — see docs/SCHEDULER.md ---
# Seconds GET /api/v1/alerts/health-summary (the public console banner)
# reuses one computed answer, so page loads don't each wake the database.
ALERT_HEALTH_SUMMARY_TTL_SECONDS=60
