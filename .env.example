# Root-level env file — read by `docker compose` ONLY, for variable
# substitution in docker-compose.yml (database/Grafana passwords, the API
# container's JWT_SECRET and published PORT). It is NOT where app settings
# go: those — including the AI assistant's LLM_PROVIDER / LLM_CLOUD_API_KEY —
# live in backend/.env (see backend/.env.example), which the Docker "api"
# container loads directly (env_file, Phase 15.2). So ONE file, backend/.env,
# configures the app in both the Docker and the no-Docker mode.
#
# Copy this file to .env (project root) and adjust values for your local
# machine. Never commit the real .env file — it is gitignored.

# Credentials for the "db" Postgres service (docker-compose.yml), Phase 9.
# Only used locally, inside your own docker-compose network — still, pick a
# real password rather than leaving the placeholder below.
POSTGRES_USER=irrigation
POSTGRES_PASSWORD=change-me-to-a-real-local-password
POSTGRES_DB=smart_irrigation

# Admin password for the "grafana" service (docker-compose.yml), Phase 10.
# Login at http://127.0.0.1:3000 with username "admin" and this password.
# Only used locally — still, pick a real password rather than the placeholder.
GF_SECURITY_ADMIN_PASSWORD=change-me-to-a-real-local-password

# --- API container (docker-compose.yml "api" service), Phase 13 ---
# Secret key signing JWT access/refresh tokens issued by the containerized
# API — the same setting as backend/.env.example's JWT_SECRET, but read
# here because docker-compose.yml sets it in the "api" service's
# `environment:` block, which wins over backend/.env inside the container.
# Generate a strong one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-real-secret-see-comment-above

# AI assistant (LLM_PROVIDER, LLM_CLOUD_API_KEY): NOT set here any more —
# put them in backend/.env, which reaches the Docker container too
# (Phase 15.2). A key left in this file is ignored by the container;
# scripts/ensure_env.ps1 (run by START.bat) moves an old one into
# backend/.env for you if backend/.env doesn't have its own yet.

# Host port the "api" service is published on — open http://localhost:<PORT>
# after `docker compose up`. Change this if 8000 is already in use.
PORT=8000
